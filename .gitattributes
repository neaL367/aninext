# Normalize text files to LF in the repository and in every working tree.
# Without this, Windows checkouts (core.autocrlf=true) produce CRLF files
# that oxfmt rewrites, so `bun run format:check` fails locally only.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
